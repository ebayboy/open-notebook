OPEN_NOTEBOOK_ENCRYPTION_KEY=openai

# for api
API_HOST="0.0.0.0"
API_PORT="5055"

# for web frount
API_URL=http://0.0.0.0:5055
INTERNAL_API_URL=http://0.0.0.0:5055

# 多模型兼容平台
# OPENAI_COMPATIBLE_BASE_URL=http://116.198.229.83:9998/v1
# OPENAI_COMPATIBLE_API_KEY=openai

# LLM 模型
OPENAI_COMPATIBLE_BASE_URL_LLM=http://116.198.229.83:9998/v1
OPENAI_COMPATIBLE_API_KEY_LLM=openai
## MODEL_NAME=baidu/ERNIE-4.5-21B-A3B-PT

# 如果私有化模型支持嵌入
# specific = os.environ.get(f"OPENAI_COMPATIBLE_BASE_URL_{mode}") is not None
OPENAI_COMPATIBLE_BASE_URL_EMBEDDING=http://116.198.229.83:8009/v1
OPENAI_COMPATIBLE_API_KEY_EMBEDDING=openai
## Qwen3-Embedding-8B

# 音频转录与博客
# OPENAI_COMPATIBLE_BASE_URL_STT=
# OPENAI_COMPATIBLE_API_KEY_STT=
# OPENAI_COMPATIBLE_BASE_URL_TTS=
# OPENAI_COMPATIBLE_API_KEY_TTS=

# 图像
# OPENAI_COMPATIBLE_BASE_URL_VISION=
# OPENAI_COMPATIBLE_API_KEY_VISION=


# 知识图谱数据库配置
SURREAL_URL="ws://localhost:8000/rpc"
SURREAL_USER="root"
SURREAL_PASSWORD="root"
SURREAL_NAMESPACE="open_notebook"
SURREAL_DATABASE="open_notebook"

SURREAL_COMMANDS_RETRY_ENABLED=true
SURREAL_COMMANDS_RETRY_MAX_ATTEMPTS=3
SURREAL_COMMANDS_RETRY_WAIT_STRATEGY=exponential_jitter
SURREAL_COMMANDS_RETRY_WAIT_MIN=1
SURREAL_COMMANDS_RETRY_WAIT_MAX=30
SURREAL_COMMANDS_MAX_TASKS=5

FIRECRAWL_API_KEY=

JINA_API_KEY=

# Python组件的日志级别
LOGLEVEL=DEBUG

# Rust组件的日志级别（如果有）
RUST_LOG=debug

# 日志文件配置
# 日志文件路径（留空则不输出到文件）
LOG_FILE=./logs/open-notebook.log

# 日志文件轮转大小（默认：10 MB）
LOG_ROTATION=10 MB

# 日志文件保留时间（默认：7 days）
LOG_RETENTION=7 days

# 访问日志配置
# 是否启用访问日志（默认：true）
ACCESS_LOG=true

# 详细调试配置
# 是否启用详细回溯信息（默认：true）
LOG_BACKTRACE=true

# 是否启用诊断信息（默认：true）
LOG_DIAGNOSE=true

# 日志清空配置
# 是否在启动时清空日志文件（默认：false）
CLEAR_LOG_ON_START=false
